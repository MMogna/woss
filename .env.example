# Copy this file to `.env` (which git ignores) and adjust. Read by scripts/build_app.sh.
# Plain KEY=VALUE lines, no spaces around "=".

# Identifier of the built app. Use something of your own, e.g. com.yourname.woss
BUNDLE_ID=com.example.woss

# Optional: code-signing identity (see docs/BUILDING.md). Default: "Woss Dev" if present, else ad-hoc.
# SIGN_IDENTITY="Woss Dev"
